rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS (Funciones de Soporte)
    // ==========================================

    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario tiene rol de admin en un establecimiento específico
    function isAdmin(establishmentId) {
      return isAuthenticated()
        && request.auth.token.roles != null
        && request.auth.token.roles[establishmentId] == 'admin';
    }

    // Verifica si el usuario es recepcionista o admin en un establecimiento específico
    function isStaff(establishmentId) {
      return isAuthenticated()
        && request.auth.token.roles != null
        && (request.auth.token.roles[establishmentId] == 'admin' || request.auth.token.roles[establishmentId] == 'reception');
    }

    // Regla global por defecto: Denegar todo acceso no especificado explícitamente
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // COLECCIÓN GLOBAL: USERS
    // ==========================================
    match /users/{userId} {
      // Un usuario solo puede leer su propio documento de perfil
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Nadie crea ni modifica su usuario desde el cliente React
      allow write: if false;
    }

    // ==========================================
    // ARQUITECTURA MULTI-TENANT: ESTABLISHMENTS
    // ==========================================
    match /establishments/{establishmentId} {
      // Permitir lectura si el usuario pertenece al staff de este establecimiento
      allow read: if isStaff(establishmentId);
      // Solo el Admin del establecimiento puede modificar la configuración del hostel
      allow write: if isAdmin(establishmentId);

      // --- HABITACIONES Y CAMAS ---
      match /rooms/{roomId} {
        allow read: if isStaff(establishmentId);
        allow write: if isAdmin(establishmentId);

        match /beds/{bedId} {
          allow read: if isStaff(establishmentId);
          allow write: if isAdmin(establishmentId);
        }
      }

      // --- AVAILABILITY (Índice de disponibilidad) ---
      // Bloqueado para escritura directa desde React. Solo lectura para el staff.
      match /availability/{availabilityId} {
        allow read: if isStaff(establishmentId);
        allow write: if false;
      }

      // --- HUÉSPEDES ---
      match /guests/{guestId} {
        allow read: if isStaff(establishmentId);
        allow create, update: if isStaff(establishmentId);
        allow delete: if isAdmin(establishmentId);
      }

      // --- RESERVAS ---
      // FIX #1 (CRÍTICO): antes permitía create/update directo desde el cliente,
      // lo que esquivaba por completo la transacción anti-doble-reserva de
      // createReservation. Ahora es 100% exclusivo de Cloud Functions.
      match /reservations/{reservationId} {
        allow read: if isStaff(establishmentId);
        allow create, update, delete: if false; // exclusivo Cloud Functions (Admin SDK)

        match /lines/{lineId} {
          allow read: if isStaff(establishmentId);
          allow write: if false;
        }

        match /history/{eventId} {
          allow read: if isStaff(establishmentId);
          allow write: if false;
        }
      }

      // --- LISTA DE ESPERA (WAITLIST) ---
      match /waitlist/{entryId} {
        allow read, write: if isStaff(establishmentId);
      }

      // --- ESTADÍAS (STAYS) ---
      match /stays/{stayId} {
        allow read: if isStaff(establishmentId);
        allow write: if false; // Check-in/Check-out exclusivo vía Cloud Functions

        match /movements/{movementId} {
          allow read: if isStaff(establishmentId);
          allow write: if false;
        }
      }

      // --- FOLIOS (CUENTAS DE HUÉSPED) Y PAGOS ---
      // FIX #2 (CRÍTICO): antes permitía create/update directo desde el cliente,
      // lo que permitía manipular totalCharges/totalPaid/balance a mano y romper
      // la validación de saldo del checkout. Ahora es exclusivo de Cloud Functions.
      match /folios/{folioId} {
        allow read: if isStaff(establishmentId);
        allow create, update, delete: if false; // exclusivo Cloud Functions (Admin SDK)

        match /charges/{chargeId} {
          allow read: if isStaff(establishmentId);
          allow write: if false;
        }

        match /payments/{paymentId} {
          allow read: if isStaff(establishmentId);
          allow write: if false;
        }
      }

      // --- INVENTARIO Y PRODUCTOS ---
      match /products/{productId} {
        allow read: if isStaff(establishmentId);
        allow write: if isAdmin(establishmentId);
      }

      match /categories/{categoryId} {
        allow read: if isStaff(establishmentId);
        allow write: if isAdmin(establishmentId);
      }

      match /suppliers/{supplierId} {
        allow read: if isStaff(establishmentId);
        allow write: if isAdmin(establishmentId);
      }

      // FIX #3 (ACTUALIZADO): la creación de compras ahora se realiza
      // exclusivamente a través de /api/createPurchase (Admin SDK).
      // El antiguo trigger syncPurchaseStock ya no es necesario.
      match /purchases/{purchaseId} {
        allow read: if isStaff(establishmentId);
        allow create, update, delete: if false; // exclusivo backend (Admin SDK)
      }

      match /stockMovements/{movementId} {
        allow read: if isStaff(establishmentId);
        allow write: if false; // Exclusivo backend
      }

      // --- CAJA (CASH SHIFTS) ---
      match /cashShifts/{shiftId} {
        allow read: if isStaff(establishmentId);
        allow write: if false; // Apertura y cierre exclusivo backend

        match /movements/{movementId} {
          allow read: if isStaff(establishmentId);
          allow write: if false;
        }
      }

      // --- OPERACIONES Y LIMPIEZA ---
      match /cleaningTasks/{taskId} {
        allow read, write: if isStaff(establishmentId);
      }

      match /maintenanceIncidents/{incidentId} {
        allow read, write: if isStaff(establishmentId);
      }

      // --- CONFIGURACIÓN DE TARIFAS Y CANALES ---
      match /promotions/{promoId} {
        allow read: if isStaff(establishmentId);
        allow write: if isAdmin(establishmentId);
      }

      match /ratePlans/{ratePlanId} {
        allow read: if isStaff(establishmentId);
        allow write: if isAdmin(establishmentId);
      }

      match /bookingChannels/{channelId} {
        allow read: if isStaff(establishmentId);
        allow write: if isAdmin(establishmentId);
      }

      // --- AUDITORÍA Y REPORTES ---
      match /auditLogs/{logId} {
        allow read: if isAdmin(establishmentId);
        allow write: if false; // Solo el backend registra auditoría
      }

      match /dailySummaries/{dateKey} {
        allow read: if isStaff(establishmentId);
        allow write: if false; // Agregación pre-calculada por cron job / backend
      }
    }
  }
}
